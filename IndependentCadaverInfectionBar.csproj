<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <OutputType>Library</OutputType>
    <RootNamespace>IndependentCadaverInfectionBar</RootNamespace>
    <AssemblyName>InfectionBar</AssemblyName>
    <Version>1.2.0</Version>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
  </PropertyGroup>

  <PropertyGroup>
    <GameDir Condition="'$(GameDir)' == ''">$(INFECTIONBAR_GAME_DIR)</GameDir>
    <TestProfileDir Condition="'$(TestProfileDir)' == ''">$(INFECTIONBAR_PROFILE_DIR)</TestProfileDir>
    <GameManagedDir Condition="'$(GameManagedDir)' == ''">$(GameDir)\Lethal Company_Data\Managed\</GameManagedDir>
    <BepInExCoreDir Condition="'$(BepInExCoreDir)' == ''">$(TestProfileDir)\BepInEx\core\</BepInExCoreDir>
    <LethalConfigDir Condition="'$(LethalConfigDir)' == ''">$(TestProfileDir)\BepInEx\plugins\AinaVT-LethalConfig\LethalConfig\</LethalConfigDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BepInEx.AssemblyPublicizer.MSBuild" Version="0.4.3" PrivateAssets="all" />

    <Reference Include="Assembly-CSharp" Publicize="true">
      <HintPath>$(GameManagedDir)Assembly-CSharp.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine" Publicize="true">
      <HintPath>$(GameManagedDir)UnityEngine.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule" Publicize="true">
      <HintPath>$(GameManagedDir)UnityEngine.CoreModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.AnimationModule" Publicize="true">
      <HintPath>$(GameManagedDir)UnityEngine.AnimationModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.UI" Publicize="true">
      <HintPath>$(GameManagedDir)UnityEngine.UI.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.UIModule" Publicize="true">
      <HintPath>$(GameManagedDir)UnityEngine.UIModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule" Publicize="true">
      <HintPath>$(GameManagedDir)UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Unity.TextMeshPro" Publicize="true">
      <HintPath>$(GameManagedDir)Unity.TextMeshPro.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Unity.Netcode.Runtime" Publicize="true">
      <HintPath>$(GameManagedDir)Unity.Netcode.Runtime.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Unity.Collections" Publicize="true">
      <HintPath>$(GameManagedDir)Unity.Collections.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="BepInEx">
      <HintPath>$(BepInExCoreDir)BepInEx.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="LethalConfig">
      <HintPath>$(LethalConfigDir)LethalConfig.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Compile Include="src/**/*.cs" />
  </ItemGroup>
</Project>
